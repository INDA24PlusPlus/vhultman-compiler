
<program> ::= <function_decl>*
<function_decl> ::= "fn" <s> <identifier> <s>
                    "(" (<s> <type_specifier> <s> ("," <s> <type_specifier>)*)? <s> ")"
                    <s> <primitive_type> <s> <block>

<statement> ::= <variable_decl> | <return_statement> | <block> | <print_statement> | <assignment>
<assignment> ::= <identifier> <s> "=" <s> <expr> <s> ";"
<print_statement> ::= "print" <s> "(" <s> <identifier> <s> ")" <s> ";"
<while_loop> ::= "while" <s> <condition> <s> <statement>
<if_statement> ::= "if" <s> <condition> <s> <statement>
<block> ::= "{" <s> <statement>* <s> "}"
<return_statement> ::= "return" <s> <expr> <s> ";"
<condition> ::= "(" <s> <expr> <s> ")"

<variable_decl> ::= ("const" | "var") <s> <type_specifier> <s> "=" <s> <expr> <s> ";"
<type_specifier> ::= <identifier> <s> ":" <s> <primitive_type>
<primitive_type> ::= "u8"
                   | "u16"
                   | "u32"
                   | "u64"
                   | "i8"
                   | "i16"
                   | "i32"
                   | "i64"
                   | "f32"
                   | "f64"
                   | "bool"
                   | "void"

<expr> ::= <expr> <s> <operator> <s> <expr>
         | "(" <s> <expr> <s> ")"
         | <integer>
         | <identifier>
         | <bool>
         | <call>

<call> ::= <identifier> <s> "(" (<s> <expr> <s> ("," <s> <expr>)*)? <s> ")"
<bool> ::= "true" | "false"
<identifier> ::= ([A-Z] | [a-z]) (([A-Z] | [a-z]) | [0-9])*
<operator> ::= "+" | "-" | "*" | "/" | "==" | "!=" | ">=" | "<=" | "<" | ">"
<integer> ::= <digit> | <digit> <integer>
<digit> ::= [0-9]
<s> ::= ((" " | "\n" | "\t")+)?
